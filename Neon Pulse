function spawnEnemy() {
  const d = getDiff();
  const side = Math.floor(Math.random() * 4);
  let x, y;
  if (side === 0) { x = Math.random() * W; y = -30; }
  else if (side === 1) { x = W + 30; y = Math.random() * H; }
  else if (side === 2) { x = Math.random() * W; y = H + 30; }
  else { x = -30; y = Math.random() * H; }
  const typeRoll = Math.random();
  let type = 'basic';
  if (wave > 3 && typeRoll > 0.65) type = 'fast';
  if (wave > 6 && typeRoll > 0.82) type = 'tank';
  if (wave > 8 && typeRoll > 0.90) type = 'shooter';
  const base = {
    basic:  { r: 16, hp: 18 + wave * 3, speed: 1.2 + wave * 0.06, color: '#ff4466', score: 10 },
    fast:   { r: 12, hp: 12 + wave * 2, speed: 2.4 + wave * 0.08, color: '#ffaa00', score: 15 },
    tank:   { r: 24, hp: 60 + wave * 8, speed: 0.8 + wave * 0.03, color: '#aa44ff', score: 35 },
    shooter:{ r: 15, hp: 28 + wave * 4, speed: 1.0 + wave * 0.04, color: '#44aaff', score: 30, shootCd: 0 }
  }[type];
  const hp = Math.max(1, Math.floor(base.hp * d.enemyHp));
  enemies.push({
    x, y, r: base.r, hp, maxHp: hp,
    speed: base.speed * d.enemySpd,
    color: base.color, score: Math.floor(base.score * d.creditMult),
    type, shootCd: base.shootCd || 0, vx: 0, vy: 0
  });
}
function spawnBoss() {
  const d = getDiff();
  const isCata = save.difficulty === 'catastrophic';
  const baseHp = 220 + wave * 25;
  const hp = Math.floor(baseHp * d.enemyHp * (isCata ? 3.5 : 1));
  const radius = isCata ? 72 : 38;
  enemies.push({
    x: W / 2 + (Math.random() - 0.5) * 80, y: -80,
    r: radius, hp, maxHp: hp,
    speed: (0.55 + wave * 0.02) * d.enemySpd * (isCata ? 0.85 : 1),
    color: isCata ? '#ff0044' : '#ff22aa',
    score: Math.floor(200 * d.creditMult * (isCata ? 4 : 1)),
    type: 'boss', shootCd: isCata ? 30 : 50, patternTimer: 0, vx: 0, vy: 0,
    huge: isCata
  });
  sfx.wave();
}
function startWave() {
  const d = getDiff();
  enemiesToSpawn = Math.floor((5 + wave * 2) * d.spawn);
  if (wave % 5 === 0) {
    enemiesToSpawn += Math.floor(4 * d.spawn);
    spawnBoss();
  }
  spawnTimer = 0;
}
function nextWave() {
  wave++;

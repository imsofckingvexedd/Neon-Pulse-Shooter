<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neon Pulse - 2D Shooter</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #0a0a0f;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    font-family: 'Segoe UI', system-ui, sans-serif;
    overflow: hidden;
    color: #e0e0ff;
  }
  #gameContainer {
    position: relative;
    box-shadow: 0 0 40px rgba(0, 255, 200, 0.15);
  }
  canvas {
    display: block;
    background: #0d0d14;
    border: 2px solid #1a1a2e;
    border-radius: 8px;
    cursor: crosshair;
  }
  #ui {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }
  #hud {
    position: absolute;
    top: 12px; left: 16px;
    font-size: 15px;
    line-height: 1.5;
    text-shadow: 0 0 8px #00ffc8;
  }
  #hud span { color: #00ffc8; font-weight: 600; }
  #overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 12, 0.9);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: auto;
    transition: opacity 0.25s;
  }
  #overlay.hidden { opacity: 0; pointer-events: none; }
  h1 {
    font-size: 42px;
    letter-spacing: 4px;
    color: #00ffc8;
    text-shadow: 0 0 20px #00ffc8, 0 0 40px #00ffc8;
    margin-bottom: 6px;
  }
  .subtitle { color: #8888aa; margin-bottom: 20px; font-size: 14px; }
  button {
    background: transparent;
    border: 2px solid #00ffc8;
    color: #00ffc8;
    padding: 10px 28px;
    font-size: 16px;
    letter-spacing: 2px;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s;
    margin: 5px;
  }
  button:hover {
    background: #00ffc8;
    color: #0a0a0f;
    box-shadow: 0 0 18px #00ffc8;
  }
  button.secondary {
    border-color: #aa88ff;
    color: #aa88ff;
  }
  button.secondary:hover {
    background: #aa88ff;
    color: #0a0a0f;
    box-shadow: 0 0 18px #aa88ff;
  }
  button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .controls {
    margin-top: 18px;
    font-size: 12px;
    color: #666688;
    text-align: center;
    line-height: 1.55;
  }
  #finalScore { font-size: 20px; margin: 10px 0; color: #fff; }
  .credits-line { color: #ffcc00; margin: 6px 0 12px; font-size: 15px; }
  .shop-panel {
    background: rgba(8, 8, 18, 0.97);
    border: 2px solid #00ffc8;
    border-radius: 12px;
    padding: 18px 20px;
    width: 480px;
    max-width: 94%;
    max-height: 92%;
    overflow-y: auto;
    text-align: left;
  }
  .shop-panel h2 {
    color: #00ffc8;
    text-align: center;
    letter-spacing: 3px;
    margin-bottom: 8px;
  }
  .shop-credits {
    text-align: center;
    color: #ffcc00;
    font-size: 17px;
    margin-bottom: 14px;
  }
  .shop-section { margin-bottom: 14px; }
  .shop-section h3 {
    color: #aa88ff;
    font-size: 13px;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }
  .shop-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 9px;
    background: rgba(255,255,255,0.04);
    border-radius: 6px;
    margin-bottom: 5px;
    font-size: 13px;
  }
  .shop-item .name { color: #e0e0ff; font-weight: 600; }
  .shop-item .desc { color: #777; font-size: 11px; }
  .shop-item button {
    padding: 5px 12px;
    font-size: 12px;
    margin: 0;
    min-width: 64px;
  }
  .skin-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 7px;
  }
  .skin-btn {
    background: rgba(0,0,0,0.45);
    border: 2px solid #333;
    border-radius: 8px;
    padding: 9px 2px;
    text-align: center;
    cursor: pointer;
    font-size: 22px;
    transition: all 0.15s;
    color: #ccc;
  }
  .skin-btn:hover, .skin-btn.selected {
    border-color: #00ffc8;
    background: rgba(0,255,200,0.12);
    box-shadow: 0 0 10px rgba(0,255,200,0.25);
  }
  .skin-btn .label {
    display: block;
    font-size: 10px;
    margin-top: 3px;
    color: #999;
  }
</style>
</head>
<body>
<div id="gameContainer">
  <canvas id="c" width="900" height="600"></canvas>
  <div id="ui">
    <div id="hud">
      SCORE <span id="score">0</span><br>
      HEALTH <span id="health">150</span><br>
      WAVE <span id="wave">1</span>
    </div>
    <div id="overlay">
      <div id="menuView">
        <h1>NEON PULSE</h1>
        <div class="subtitle">survive the waves. don't get cooked.</div>
        <div id="diffRow" style="margin-bottom:14px;display:flex;gap:6px;justify-content:center;flex-wrap:wrap;">
          <button id="diffEasy" class="secondary" style="padding:6px 12px;font-size:12px;">EASY</button>
          <button id="diffNormal" style="padding:6px 12px;font-size:12px;">NORMAL</button>
          <button id="diffHard" class="secondary" style="padding:6px 12px;font-size:12px;">HARD</button>
          <button id="diffCatastrophic" class="secondary" style="padding:6px 12px;font-size:12px;border-color:#ff3355;color:#ff3355;">CATASTROPHIC</button>
        </div>
        <button id="btnStart">START</button>
        <button id="btnShop" class="secondary">SHOP</button>
        <button id="btnFarm" class="secondary">FARM</button>
        <button id="btnAccount" class="secondary">ACCOUNT</button>
        <button id="btnFeedback" class="secondary">FEEDBACK</button>
        <div class="controls">
          WASD / Arrows — move<br>
          Mouse — aim & shoot<br>
          Space — also shoot
        </div>
      </div>
      <div id="shopView" style="display:none;"></div>
      <div id="farmView" style="display:none;"></div>
      <div id="accountView" style="display:none;"></div>
      <div id="feedbackView" style="display:none;"></div>
      <div id="gameoverView" style="display:none;">
        <h1>GAME OVER</h1>
        <div id="finalScore"></div>
        <div class="credits-line" id="earnedCredits"></div>
        <button id="btnRetry">TRY AGAIN</button>
        <button id="btnShopFromGO" class="secondary">SHOP</button>
        <div class="controls">you almost had it tho</div>
      </div>
    </div>
  </div>
</div>
<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
const W = canvas.width;
const H = canvas.height;
const overlay = document.getElementById('overlay');
const menuView = document.getElementById('menuView');
const shopView = document.getElementById('shopView');
const farmView = document.getElementById('farmView');
const accountView = document.getElementById('accountView');
const feedbackView = document.getElementById('feedbackView');
const gameoverView = document.getElementById('gameoverView');
const scoreEl = document.getElementById('score');
const healthEl = document.getElementById('health');
const waveEl = document.getElementById('wave');

let gameState = 'menu';
let score = 0;
let wave = 1;
let keys = {};
let mouse = { x: W/2, y: H/2, down: false };
let lastShot = 0;
let shake = 0;
let powerupSpawnTimer = 0;

const ACCOUNTS_KEY = 'neonPulseAccounts_v1';
const SESSION_KEY = 'neonPulseSession_v1';
const defaultSave = {
  credits: 0,
  upgrades: { health: 0, damage: 0, shield: 0, speed: 0, firerate: 0, multishot: 0, regen: 0 },
  cursorSkin: 'default',
  gunSkin: 'default',
  unlockedCursors: ['default'],
  unlockedGuns: ['default'],
  unlockedBullets: ['default'],
  bulletSkin: 'default',
  difficulty: 'normal',
  farm: {
    generators: { clicker: 0, drone: 0, miner: 0, reactor: 0, singularity: 0 },
    lastTick: Date.now()
  }
};

function simpleHash(str) {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return (h >>> 0).toString(16);
}
function loadAccounts() {
  try {
    return JSON.parse(localStorage.getItem(ACCOUNTS_KEY) || '{}');
  } catch (e) { return {}; }
}
function writeAccounts(acc) {
  localStorage.setItem(ACCOUNTS_KEY, JSON.stringify(acc));
}
function normalizeSave(parsed) {
  return {
    ...defaultSave,
    ...parsed,
    upgrades: { ...defaultSave.upgrades, ...((parsed && parsed.upgrades) || {}) },
    unlockedCursors: (parsed && parsed.unlockedCursors) || ['default'],
    unlockedGuns: (parsed && parsed.unlockedGuns) || ['default'],
    unlockedBullets: (parsed && parsed.unlockedBullets) || ['default'],
    farm: {
      generators: { ...defaultSave.farm.generators, ...((parsed && parsed.farm && parsed.farm.generators) || {}) },
      lastTick: (parsed && parsed.farm && parsed.farm.lastTick) || Date.now()
    }
  };
}
function getSessionUser() {
  return localStorage.getItem(SESSION_KEY) || null;
}
function setSessionUser(username) {
  if (username) localStorage.setItem(SESSION_KEY, username);
  else localStorage.removeItem(SESSION_KEY);
}
function loadSave() {
  const user = getSessionUser();
  if (user) {
    const acc = loadAccounts();
    if (acc[user] && acc[user].save) return normalizeSave(acc[user].save);
  }
  // migrate old single-save if present
  try {
    const old = localStorage.getItem('neonPulseSave_v2');
    if (old) return normalizeSave(JSON.parse(old));
  } catch (e) {}
  return JSON.parse(JSON.stringify(defaultSave));
}
function writeSave() {
  const user = getSessionUser();
  if (user) {
    const acc = loadAccounts();
    if (acc[user]) {
      acc[user].save = save;
      writeAccounts(acc);
    }
  } else {
    localStorage.setItem('neonPulseSave_v2', JSON.stringify(save));
  }
}
function createAccount(username, password) {
  username = (username || '').trim().toLowerCase();
  if (!username || username.length < 3) return 'username must be at least 3 characters';
  if (!/^[a-z0-9_]+$/.test(username)) return 'only letters, numbers, underscore';
  if (!password || password.length < 4) return 'password must be at least 4 characters';
  const acc = loadAccounts();
  if (acc[username]) return 'username already taken';
  acc[username] = {
    pass: simpleHash(password + '::' + username),
    created: Date.now(),
    save: JSON.parse(JSON.stringify(defaultSave))
  };
  writeAccounts(acc);
  setSessionUser(username);
  save = normalizeSave(acc[username].save);
  return null;
}
function loginAccount(username, password) {
  username = (username || '').trim().toLowerCase();
  const acc = loadAccounts();
  if (!acc[username]) return 'account not found';
  if (acc[username].pass !== simpleHash(password + '::' + username)) return 'wrong password';
  // save current guest progress? no - switch fully
  setSessionUser(username);
  save = normalizeSave(acc[username].save);
  // claim offline farm
  if (typeof tickFarm === 'function') tickFarm(true);
  return null;
}
function logoutAccount() {
  writeSave();
  setSessionUser(null);
  save = JSON.parse(JSON.stringify(defaultSave));
}
let save = loadSave();

// ========== IDLE FARM ==========
const FARM_GENS = {
  clicker:     { name: 'Auto Clicker',  desc: '0.5 💰/sec each',  rate: 0.5,  baseCost: 15,   costScale: 1.15 },
  drone:       { name: 'Scrap Drone',   desc: '4 💰/sec each',    rate: 4,    baseCost: 100,  costScale: 1.18 },
  miner:       { name: 'Credit Miner',  desc: '25 💰/sec each',   rate: 25,   baseCost: 800,  costScale: 1.2 },
  reactor:     { name: 'Neon Reactor',  desc: '150 💰/sec each',  rate: 150,  baseCost: 6000, costScale: 1.22 },
  singularity: { name: 'Singularity',   desc: '1000 💰/sec each', rate: 1000, baseCost: 50000,costScale: 1.25 }
};

function getFarmGenCost(key) {
  const def = FARM_GENS[key];
  const owned = (save.farm.generators[key] || 0);
  return Math.floor(def.baseCost * Math.pow(def.costScale, owned));
}
function getFarmRate() {
  let total = 0;
  for (const [key, def] of Object.entries(FARM_GENS)) {
    total += (save.farm.generators[key] || 0) * def.rate;
  }
  return total;
}
function tickFarm(forceSave) {
  if (!save.farm) {
    save.farm = { generators: { clicker: 0, drone: 0, miner: 0, reactor: 0, singularity: 0 }, lastTick: Date.now() };
  }
  const now = Date.now();
  const elapsed = Math.min(86400, (now - (save.farm.lastTick || now)) / 1000); // cap 24h offline
  const rate = getFarmRate();
  if (elapsed > 0.2 && rate > 0) {
    save.credits += rate * elapsed;
    save.farm.lastTick = now;
    if (forceSave !== false) writeSave();
    return rate * elapsed;
  }
  save.farm.lastTick = now;
  return 0;
}
function buyFarmGen(key) {
  const cost = getFarmGenCost(key);
  if (save.credits < cost) return false;
  save.credits -= cost;
  save.farm.generators[key] = (save.farm.generators[key] || 0) + 1;
  writeSave();
  return true;
}
function manualFarmClick() {
  // click power scales with clickers owned a bit
  const bonus = 1 + (save.farm.generators.clicker || 0) * 0.15;
  const gain = Math.floor(1 * bonus);
  save.credits += gain;
  writeSave();
  return gain;
}

const UPGRADE_DEFS = {
  health:   { name: 'Max Health',  desc: '+25 HP per level',           max: 6, baseCost: 60,  costScale: 1.5 },
  damage:   { name: 'Damage',      desc: '+4 dmg per level',           max: 6, baseCost: 80,  costScale: 1.55 },
  shield:   { name: 'Shield',      desc: '-10% dmg taken per level',   max: 5, baseCost: 100, costScale: 1.6 },
  speed:    { name: 'Move Speed',  desc: '+0.45 speed per level',      max: 5, baseCost: 70,  costScale: 1.5 },
  firerate: { name: 'Fire Rate',   desc: 'shoot faster per level',     max: 5, baseCost: 90,  costScale: 1.55 },
  multishot:{ name: 'Multi Shot',  desc: '+1 extra bullet per level',  max: 3, baseCost: 150, costScale: 1.8 },
  regen:    { name: 'Regen',       desc: '+0.4 HP/sec per level',      max: 4, baseCost: 110, costScale: 1.65 }
};
const CURSOR_SKINS = {
  default: { label: 'Default', cost: 0 },
  heart:   { label: 'Heart',   cost: 40 },
  star:    { label: 'Star',    cost: 70 },
  ghost:   { label: 'Ghost',   cost: 90 },
  fire:    { label: 'Fire',    cost: 150 }
};
// reset if player had a removed skin selected
if (!CURSOR_SKINS[save.cursorSkin]) {
  save.cursorSkin = 'default';
  writeSave();
}

// Drawn cursor artwork (no emojis)
function drawCursorArt(id, x, y) {
  ctx.save();
  ctx.translate(x + 14, y + 14);
  ctx.scale(0.9, 0.9);

  if (id === 'default') {
    // simple crosshair already handled by CSS
  }
  else if (id === 'heart') {
    ctx.fillStyle = '#ff4d6d';
    ctx.shadowColor = '#ff4d6d';
    ctx.shadowBlur = 8;
    ctx.beginPath();
    ctx.moveTo(0, 6);
    ctx.bezierCurveTo(-12, -6, -18, 8, 0, 18);
    ctx.bezierCurveTo(18, 8, 12, -6, 0, 6);
    ctx.fill();
  }
  else if (id === 'star') {
    ctx.fillStyle = '#ffd700';
    ctx.shadowColor = '#ffaa00';
    ctx.shadowBlur = 10;
    ctx.beginPath();
    for (let i = 0; i < 5; i++) {
      const a = (i * 4 * Math.PI) / 5 - Math.PI / 2;
      const r = i % 2 === 0 ? 14 : 6;
      const px = Math.cos(a) * r;
      const py = Math.sin(a) * r;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.fill();
  }
  else if (id === 'ghost') {
    ctx.fillStyle = 'rgba(220,230,255,0.9)';
    ctx.shadowColor = '#aaf';
    ctx.shadowBlur = 12;
    ctx.beginPath();
    ctx.arc(0, -2, 11, Math.PI, 0);
    ctx.lineTo(11, 12);
    ctx.quadraticCurveTo(7, 8, 4, 12);
    ctx.quadraticCurveTo(0, 8, -4, 12);
    ctx.quadraticCurveTo(-7, 8, -11, 12);
    ctx.closePath();
    ctx.fill();
    // eyes
    ctx.fillStyle = '#223';
    ctx.beginPath();
    ctx.arc(-4, -1, 2.2, 0, Math.PI * 2);
    ctx.arc(4, -1, 2.2, 0, Math.PI * 2);
    ctx.fill();
  }
  else if (id === 'fire') {
    // flame layers
    const flames = [
      { c: '#ff4400', s: 1.0 },
      { c: '#ff8800', s: 0.75 },
      { c: '#ffcc00', s: 0.5 }
    ];
    flames.forEach((f, i) => {
      ctx.fillStyle = f.c;
      ctx.shadowColor = f.c;
      ctx.shadowBlur = 10 - i * 3;
      ctx.beginPath();
      ctx.moveTo(0, 14);
      ctx.quadraticCurveTo(-12 * f.s, 0, -6 * f.s, -12 * f.s);
      ctx.quadraticCurveTo(0, -4 * f.s, 6 * f.s, -12 * f.s);
      ctx.quadraticCurveTo(12 * f.s, 0, 0, 14);
      ctx.fill();
    });
  }

  ctx.restore();
}
const GUN_SKINS = {
  default: { label: 'Neon',    color: '#00ffc8', cost: 0 },
  pink:    { label: 'Pink',    color: '#ff66cc', cost: 50 },
  gold:    { label: 'Gold',    color: '#ffcc00', cost: 110 },
  purple:  { label: 'Void',    color: '#cc66ff', cost: 160 },
  red:     { label: 'Crimson', color: '#ff3355', cost: 220 },
  ice:     { label: 'Ice',     color: '#88eeff', cost: 190 }
};

const BULLET_SKINS = {
  default:  { label: 'Orb',       shape: 'orb',     color: '#00ffc8', glow: '#00ffc8', cost: 0,    dmg: 1.0 },
  plasma:   { label: 'Plasma',    shape: 'laser',   color: '#00ffaa', glow: '#66ffdd', cost: 500,  dmg: 1.15 },
  starbolt: { label: 'Starbolt',  shape: 'star',    color: '#ffdd44', glow: '#ffaa00', cost: 800,  dmg: 1.25 },
  heart:    { label: 'Heart',     shape: 'heart',   color: '#ff66aa', glow: '#ff2288', cost: 1000, dmg: 1.1 },
  crystal:  { label: 'Crystal',   shape: 'crystal', color: '#88ccff', glow: '#44aaff', cost: 1300, dmg: 1.35 },
  ember:    { label: 'Ember',     shape: 'ember',   color: '#ff6622', glow: '#ff3300', cost: 1600, dmg: 1.45 },
  void:     { label: 'Void',      shape: 'void',    color: '#cc66ff', glow: '#aa22ff', cost: 2000, dmg: 1.55 },
  shard:    { label: 'Shard',     shape: 'shard',   color: '#aaffee', glow: '#66ffcc', cost: 1200, dmg: 1.3 },
  rail:     { label: 'Rail',      shape: 'laser',   color: '#ffffff', glow: '#aaddff', cost: 2500, dmg: 1.8 },
  nova:     { label: 'Nova',      shape: 'star',    color: '#ff44ff', glow: '#ff00aa', cost: 3000, dmg: 2.0 }
};
if (!BULLET_SKINS[save.bulletSkin]) {
  save.bulletSkin = 'default';
  writeSave();
}

const DIFFICULTY = {
  easy:         { label: 'EASY',         enemyHp: 0.7,  enemySpd: 0.85, enemyDmg: 0.7,  spawn: 0.8,  creditMult: 0.7 },
  normal:       { label: 'NORMAL',       enemyHp: 1.0,  enemySpd: 1.0,  enemyDmg: 1.0,  spawn: 1.0,  creditMult: 1.0 },
  hard:         { label: 'HARD',         enemyHp: 1.45, enemySpd: 1.2,  enemyDmg: 1.35, spawn: 1.25, creditMult: 1.5 },
  catastrophic: { label: 'CATASTROPHIC', enemyHp: 2.4,  enemySpd: 1.55, enemyDmg: 2.0,  spawn: 6.0,  creditMult: 2.5 }
};
function getDiff() {
  return DIFFICULTY[save.difficulty] || DIFFICULTY.normal;
}

function getUpgradeCost(key) {
  const def = UPGRADE_DEFS[key];
  const lvl = save.upgrades[key] || 0;
  return Math.floor(def.baseCost * Math.pow(def.costScale, lvl));
}
function getPlayerStats() {
  const u = save.upgrades;
  const h = u.health || 0;
  const d = u.damage || 0;
  const s = u.shield || 0;
  const sp = u.speed || 0;
  const fr = u.firerate || 0;
  const ms = u.multishot || 0;
  const rg = u.regen || 0;
  return {
    maxHp: 150 + h * 25,
    damage: 18 + d * 4,
    dmgReduction: Math.min(0.5, s * 0.10),
    speed: 5.0 + sp * 0.45,
    fireRate: Math.max(40, 100 - fr * 12),
    multishot: ms,
    regen: rg * 0.4
  };
}

const player = {
  x: W/2, y: H/2, r: 14, speed: 5.0,
  hp: 150, maxHp: 150, damage: 18,
  angle: 0, invuln: 0
};
let bullets = [];
let enemies = [];
let particles = [];
let powerups = [];
let enemiesToSpawn = 0;
let spawnTimer = 0;
let waveClearTimer = 0;

let audioCtx = null;
let masterGain = null;
function initAudio() {
  if (audioCtx) return;
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  masterGain = audioCtx.createGain();
  masterGain.gain.value = 0.32;
  masterGain.connect(audioCtx.destination);
}
function playTone({ freq = 440, type = 'square', duration = 0.1, volume = 0.3, slideTo = null, delay = 0 }) {
  if (!audioCtx) return;
  const t = audioCtx.currentTime + delay;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, t);
  if (slideTo !== null) osc.frequency.exponentialRampToValueAtTime(Math.max(20, slideTo), t + duration);
  gain.gain.setValueAtTime(0, t);
  gain.gain.linearRampToValueAtTime(volume, t + 0.005);
  gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
  osc.connect(gain);
  gain.connect(masterGain);
  osc.start(t);
  osc.stop(t + duration + 0.02);
}
function playNoise({ duration = 0.15, volume = 0.25, filterFreq = 1000 }) {
  if (!audioCtx) return;
  const t = audioCtx.currentTime;
  const bufferSize = audioCtx.sampleRate * duration;
  const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
  const noise = audioCtx.createBufferSource();
  noise.buffer = buffer;
  const filter = audioCtx.createBiquadFilter();
  filter.type = 'lowpass';
  filter.frequency.setValueAtTime(filterFreq, t);
  filter.frequency.exponentialRampToValueAtTime(100, t + duration);
  const gain = audioCtx.createGain();
  gain.gain.setValueAtTime(volume, t);
  gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
  noise.connect(filter);
  filter.connect(gain);
  gain.connect(masterGain);
  noise.start(t);
  noise.stop(t + duration + 0.02);
}

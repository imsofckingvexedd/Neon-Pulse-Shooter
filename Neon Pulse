}
function spawnParticles(x, y, color, count = 12) {
  for (let i = 0; i < count; i++) {
    const a = Math.random() * Math.PI * 2;
    const sp = 1 + Math.random() * 4;
    particles.push({
      x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
      life: 30 + Math.random() * 20, maxLife: 50, color, size: 2 + Math.random() * 3
    });
  }
}
function shoot() {
  const now = performance.now();
  const stats = getPlayerStats();
  if (now - lastShot < stats.fireRate) return;
  lastShot = now;
  const dx = mouse.x - player.x;
  const dy = mouse.y - player.y;
  const len = Math.hypot(dx, dy) || 1;
  const baseAng = Math.atan2(dy, dx);
  const bullet = BULLET_SKINS[save.bulletSkin] || BULLET_SKINS.default;
  const count = 1 + stats.multishot;
  const spread = count > 1 ? 0.18 : 0;
  for (let i = 0; i < count; i++) {
    const ang = baseAng + (i - (count - 1) / 2) * spread;
    bullets.push({
      x: player.x + Math.cos(ang) * 18,
      y: player.y + Math.sin(ang) * 18,
      vx: Math.cos(ang) * 12,
      vy: Math.sin(ang) * 12,
      r: 5, life: 100, fromPlayer: true,
      color: bullet.color, glow: bullet.glow, shape: bullet.shape,
      dmgMult: bullet.dmg || 1
    });
  }
  sfx.shoot();
}


  const map = {
    easy: 'diffEasy',
    normal: 'diffNormal',
    hard: 'diffHard',
    catastrophic: 'diffCatastrophic'
  };
  for (const [key, id] of Object.entries(map)) {
    const btn = document.getElementById(id);
    if (!btn) continue;
    if (save.difficulty === key) {
      if (key === 'catastrophic') {
        btn.style.borderColor = '#ff3355';
        btn.style.color = '#fff';
        btn.style.background = 'rgba(255,40,60,0.35)';
        btn.style.boxShadow = '0 0 14px rgba(255,40,60,0.5)';
      } else {
        btn.style.borderColor = '#00ffc8';
        btn.style.color = '#00ffc8';
        btn.style.background = 'rgba(0,255,200,0.12)';
        btn.style.boxShadow = 'none';
      }
    } else {
      if (key === 'catastrophic') {
        btn.style.borderColor = '#ff3355';
        btn.style.color = '#ff3355';
        btn.style.background = 'transparent';
        btn.style.boxShadow = 'none';
      } else {
        btn.style.borderColor = '#aa88ff';
        btn.style.color = '#aa88ff';
        btn.style.background = 'transparent';
        btn.style.boxShadow = 'none';
      }
    }
  }
}
function setDifficulty(d) {
  if (d === 'catastrophic') {
    const ok = confirm(
      '⚠ CATASTROPHIC DIFFICULTY ⚠\n\n' +
      '• Enemies have 2.4× HP\n' +
      '• Move 55% faster\n' +
      '• Deal double damage\n' +
      '• 500% MORE enemies spawn\n' +
      '• The screen will be full of them\n' +
      '• Credits ×2.5 if you somehow survive\n\n' +
      'You will get cooked.\n\nContinue anyway?'
    );
    if (!ok) return;
  }
  save.difficulty = d;
  writeSave();
  updateDiffButtons();
}
document.getElementById('diffEasy').onclick = () => setDifficulty('easy');
document.getElementById('diffNormal').onclick = () => setDifficulty('normal');
document.getElementById('diffHard').onclick = () => setDifficulty('hard');
document.getElementById('diffCatastrophic').onclick = () => setDifficulty('catastrophic');
updateDiffButtons();

document.getElementById('btnStart').onclick = startGame;
document.getElementById('btnShop').onclick = () => { renderShop(); showView('shop'); };
document.getElementById('btnFarm').onclick = () => { renderFarm(); showView('farm'); };
document.getElementById('btnAccount').onclick = () => { renderAccount(); showView('account'); };
document.getElementById('btnFeedback').onclick = () => { renderFeedback(); showView('feedback'); };
document.getElementById('btnRetry').onclick = () => { showView('menu'); updateDiffButtons(); };
document.getElementById('btnShopFromGO').onclick = () => { renderShop(); showView('shop'); };

// passive farm income even while in menus / playing
setInterval(() => {
  tickFarm(true);
  if (farmView.style.display === 'block') {
    // live-update credits + button affordability without full re-render
    const creditEl = farmView.querySelector('.shop-credits');
    if (creditEl) creditEl.textContent = '💰 ' + Math.floor(save.credits).toLocaleString();
    const rateEl = farmView.querySelector('.shop-credits + div');
    if (rateEl) rateEl.textContent = '+' + getFarmRate().toFixed(1) + ' 💰/sec';
    farmView.querySelectorAll('[data-farm]').forEach(btn => {
      const key = btn.dataset.farm;
      const cost = getFarmGenCost(key);
      btn.textContent = cost.toLocaleString() + '💰';
      btn.disabled = save.credits < cost;
    });
  }
}, 400);

// claim offline earnings on load
tickFarm(true);

function update() {
  if (gameState !== 'playing') return;
  let mx = 0, my = 0;
  if (keys['w'] || keys['arrowup']) my -= 1;
  if (keys['s'] || keys['arrowdown']) my += 1;
  if (keys['a'] || keys['arrowleft']) mx -= 1;
  if (keys['d'] || keys['arrowright']) mx += 1;
  if (mx || my) {
    const len = Math.hypot(mx, my);
    player.x += (mx / len) * player.speed;
    player.y += (my / len) * player.speed;
  }
  player.x = Math.max(player.r, Math.min(W - player.r, player.x));
  player.y = Math.max(player.r, Math.min(H - player.r, player.y));
  player.angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);
  if (mouse.down || keys[' ']) shoot();
  if (player.invuln > 0) player.invuln--;

  // passive regen
  const regen = getPlayerStats().regen;
  if (regen > 0 && player.hp < player.maxHp) {
    player.hp = Math.min(player.maxHp, player.hp + regen / 60);
    if (Math.random() < 0.05) updateHUD();
  }

  // keep speed in sync with upgrades
  player.speed = getPlayerStats().speed;

  if (enemiesToSpawn > 0) {
    spawnTimer--;
    if (spawnTimer <= 0) {
      spawnEnemy();
      enemiesToSpawn--;
      const baseInterval = Math.max(22, 55 - wave * 2);
      spawnTimer = save.difficulty === 'catastrophic' ? Math.max(6, Math.floor(baseInterval * 0.35)) : baseInterval;
    }
  } else if (enemies.length === 0) {
    waveClearTimer++;
    if (waveClearTimer > 90) {
      nextWave();
      waveClearTimer = 0;
    }
  }

  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    b.x += b.vx; b.y += b.vy; b.life--;
    if (b.life <= 0 || b.x < -30 || b.x > W + 30 || b.y < -30 || b.y > H + 30) bullets.splice(i, 1);
  }

  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i];
    const dx = player.x - e.x;
    const dy = player.y - e.y;
    const dist = Math.hypot(dx, dy) || 1;
    e.vx = (dx / dist) * e.speed;
    e.vy = (dy / dist) * e.speed;
    e.x += e.vx; e.y += e.vy;

    // enemy-enemy collision (push apart)
    for (let j = i + 1; j < enemies.length; j++) {
      const o = enemies[j];
      const ox = e.x - o.x;
      const oy = e.y - o.y;
      const od = Math.hypot(ox, oy) || 0.01;
      const minDist = e.r + o.r;
      if (od < minDist) {
        const push = (minDist - od) * 0.5;
        const nx = ox / od;
        const ny = oy / od;
        // bosses push harder / don't get pushed as much
        const eW = e.type === 'boss' ? 0.15 : 1;
        const oW = o.type === 'boss' ? 0.15 : 1;
        e.x += nx * push * eW;
        e.y += ny * push * eW;
        o.x -= nx * push * oW;
        o.y -= ny * push * oW;
      }
    }

    if (e.type === 'shooter') {
      e.shootCd = (e.shootCd || 0) - 1;
      if (e.shootCd <= 0 && dist < 380) {
        e.shootCd = 70 - Math.min(25, wave);
        bullets.push({ x: e.x, y: e.y, vx: (dx / dist) * 5.5, vy: (dy / dist) * 5.5, r: 5, life: 100, fromPlayer: false, color: '#44aaff' });
        sfx.enemyShoot();
      }
    }
    if (e.type === 'boss') {
      e.shootCd = (e.shootCd || 0) - 1;
      e.patternTimer = (e.patternTimer || 0) + 1;
      const keepDist = e.huge ? 220 : 180;
      if (dist < keepDist) { e.vx *= 0.9; e.vy *= 0.9; }
      if (e.shootCd <= 0) {
        if (e.huge) {
          // catastrophic boss: full ring + aimed volleys
          if (e.patternTimer % 200 < 100) {
            for (let a = 0; a < Math.PI * 2; a += Math.PI / 8) {
              bullets.push({
                x: e.x, y: e.y,
                vx: Math.cos(a) * 3.8, vy: Math.sin(a) * 3.8,
                r: 7, life: 140, fromPlayer: false, color: '#ff0044'
              });
            }
            e.shootCd = 40;
          } else {
            for (let k = -3; k <= 3; k++) {
              const ang = Math.atan2(dy, dx) + k * 0.14;
              bullets.push({
                x: e.x, y: e.y,
                vx: Math.cos(ang) * 6.2, vy: Math.sin(ang) * 6.2,
                r: 6, life: 130, fromPlayer: false, color: '#ff66aa'
              });
            }
            e.shootCd = 28;
          }
        } else if (e.patternTimer % 180 < 90) {
          for (let a = -0.6; a <= 0.6; a += 0.3) {
            const ang = Math.atan2(dy, dx) + a;
            bullets.push({ x: e.x, y: e.y, vx: Math.cos(ang) * 4.2, vy: Math.sin(ang) * 4.2, r: 6, life: 130, fromPlayer: false, color: '#ff22aa' });
          }
          e.shootCd = 55;
        } else {
          for (let k = -1; k <= 1; k++) {
            const ang = Math.atan2(dy, dx) + k * 0.18;
            bullets.push({ x: e.x, y: e.y, vx: Math.cos(ang) * 5.8, vy: Math.sin(ang) * 5.8, r: 5, life: 120, fromPlayer: false, color: '#ff66cc' });
          }
          e.shootCd = 38;
        }
        sfx.enemyShoot();
      }
    }

    if (dist < e.r + player.r && player.invuln <= 0) {
      const base = e.type === 'boss' ? (e.huge ? 28 : 16) : e.type === 'tank' ? 10 : e.type === 'fast' ? 6 : 7;
      const stats = getPlayerStats();
      player.hp -= Math.max(1, Math.floor(base * getDiff().enemyDmg * (1 - stats.dmgReduction)));
      player.invuln = e.type === 'boss' ? 60 : 50;
      shake = e.type === 'boss' ? 14 : 8;
      spawnParticles(player.x, player.y, '#00ffc8', 8);
      sfx.hurt();
      updateHUD();
      if (player.hp <= 0) { gameState = 'gameover'; sfx.gameover(); showGameOver(); }
    }

    for (let j = bullets.length - 1; j >= 0; j--) {
      const b = bullets[j];
      if (!b.fromPlayer) continue;
      if (Math.hypot(b.x - e.x, b.y - e.y) < e.r + b.r) {
        e.hp -= player.damage * (b.dmgMult || 1);
        bullets.splice(j, 1);
        spawnParticles(b.x, b.y, e.color, 6);
        sfx.hit();
        if (e.hp <= 0) {
          score += e.score;
          const isBoss = e.type === 'boss';
          spawnParticles(e.x, e.y, e.color, isBoss ? 40 : 18);
          sfx.explode();
          if (isBoss) {
            powerups.push({ x: e.x, y: e.y, type: 'health', life: 500, r: 12 });
            powerups.push({ x: e.x + 28, y: e.y - 18, type: 'health', life: 500, r: 11 });
            spawnParticles(e.x, e.y, '#ffffff', 18);
          } else if (Math.random() < 0.55) {
            powerups.push({ x: e.x, y: e.y, type: 'health', life: 400, r: 10 });
          }
          enemies.splice(i, 1);
          updateHUD();
          break;
        }
      }
    }
  }

  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    if (b.fromPlayer) continue;
    if (Math.hypot(b.x - player.x, b.y - player.y) < player.r + b.r && player.invuln <= 0) {
      const stats = getPlayerStats();
      player.hp -= Math.max(1, Math.floor(8 * getDiff().enemyDmg * (1 - stats.dmgReduction)));
      player.invuln = 45;
      shake = 8;
      bullets.splice(i, 1);
      spawnParticles(player.x, player.y, '#ff4466', 8);
      sfx.hurt();
      updateHUD();
      if (player.hp <= 0) { gameState = 'gameover'; sfx.gameover(); showGameOver(); }
    }
  }

  powerupSpawnTimer++;
  if (powerupSpawnTimer > 180) {
    powerupSpawnTimer = 0;
    if (powerups.length < 8 && Math.random() < 0.7) {
      powerups.push({ x: 40 + Math.random() * (W - 80), y: 40 + Math.random() * (H - 80), type: 'health', life: 500, r: 11 });
    }
  }

  for (let i = powerups.length - 1; i >= 0; i--) {
    const p = powerups[i];
    p.life--;
    if (p.life <= 0) { powerups.splice(i, 1); continue; }
    if (Math.hypot(p.x - player.x, p.y - player.y) < player.r + p.r) {
      player.hp = Math.min(player.maxHp, player.hp + 40);
      updateHUD();
      spawnParticles(p.x, p.y, '#00ff88', 10);
      sfx.powerup();
      powerups.splice(i, 1);
    }
  }

  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx; p.y += p.vy;
    p.vx *= 0.96; p.vy *= 0.96;
    p.life--;
    if (p.life <= 0) particles.splice(i, 1);
  }
  if (shake > 0) shake *= 0.85;
}

function draw() {
  ctx.save();
  if (shake > 0.5) ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
  ctx.fillStyle = '#0d0d14';
  ctx.fillRect(0, 0, W, H);
  ctx.strokeStyle = 'rgba(0, 255, 200, 0.03)';
  ctx.lineWidth = 1;
  for (let x = 0; x < W; x += 40) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
  for (let y = 0; y < H; y += 40) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }

  particles.forEach(p => {
    ctx.globalAlpha = p.life / p.maxLife;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size * (p.life / p.maxLife), 0, Math.PI * 2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;

  powerups.forEach(p => {
    const pulse = 0.7 + Math.sin(Date.now() / 150) * 0.3;
    ctx.fillStyle = 'rgba(0, 255, 136, ' + pulse + ')';
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#00ff88';
    ctx.lineWidth = 2;
    ctx.stroke();
  });

  bullets.forEach(b => {
    const col = b.fromPlayer ? (b.color || '#00ffc8') : (b.color || '#ff4466');
    const glow = b.fromPlayer ? (b.glow || b.color || '#00ffc8') : col;
    const shape = b.fromPlayer ? (b.shape || 'orb') : 'orb';
    const t = Date.now() / 1000;

    ctx.save();
    ctx.translate(b.x, b.y);

    if (b.fromPlayer) {
      const ang = Math.atan2(b.vy, b.vx);
      ctx.rotate(ang);

      // motion trail
      ctx.globalAlpha = 0.25;
      ctx.fillStyle = glow;
      ctx.shadowColor = glow;
      ctx.shadowBlur = 6;
      for (let i = 1; i <= 3; i++) {
        ctx.beginPath();
        ctx.arc(-i * 6, 0, Math.max(1.5, b.r - i), 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      if (shape === 'orb') {
        ctx.shadowColor = glow;
        ctx.shadowBlur = 14;
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.arc(0, 0, 5.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.globalAlpha = 0.7;
        ctx.beginPath();
        ctx.arc(-1.5, -1.5, 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      else if (shape === 'laser') {
        ctx.shadowColor = glow;
        ctx.shadowBlur = 16;
        // outer glow beam
        ctx.fillStyle = glow;
        ctx.globalAlpha = 0.35;
        ctx.fillRect(-14, -4, 28, 8);
        ctx.globalAlpha = 1;
        // core
        ctx.fillStyle = col;
        ctx.fillRect(-12, -2.2, 24, 4.4);
        // bright center line
        ctx.fillStyle = '#fff';
        ctx.fillRect(-10, -0.8, 20, 1.6);
      }
      else if (shape === 'star') {
        ctx.shadowColor = glow;
        ctx.shadowBlur = 12;
        ctx.rotate(t * 8); // spin
        ctx.fillStyle = col;
        ctx.beginPath();
        for (let i = 0; i < 5; i++) {
          const a = (i * 4 * Math.PI) / 5 - Math.PI / 2;
          const r = i % 2 === 0 ? 8 : 3.5;
          const px = Math.cos(a) * r, py = Math.sin(a) * r;
          if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.globalAlpha = 0.6;
        ctx.beginPath();
        ctx.arc(0, 0, 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      else if (shape === 'heart') {
        ctx.shadowColor = glow;
        ctx.shadowBlur = 12;
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.moveTo(0, 5);
        ctx.bezierCurveTo(-8, -4, -11, 5, 0, 12);
        ctx.bezierCurveTo(11, 5, 8, -4, 0, 5);
        ctx.fill();
        // highlight
        ctx.fillStyle = '#fff';
        ctx.globalAlpha = 0.45;
        ctx.beginPath();
        ctx.ellipse(-3, 1, 2.5, 1.5, -0.4, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      else if (shape === 'crystal') {
        ctx.shadowColor = glow;
        ctx.shadowBlur = 14;
        // main diamond
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.moveTo(0, -9); ctx.lineTo(6, 0); ctx.lineTo(0, 9); ctx.lineTo(-6, 0);
        ctx.closePath();
        ctx.fill();
        // inner facet
        ctx.fillStyle = '#fff';
        ctx.globalAlpha = 0.5;
        ctx.beginPath();
        ctx.moveTo(0, -5); ctx.lineTo(3, 0); ctx.lineTo(0, 2); ctx.lineTo(-1.5, 0);
        ctx.closePath();
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      else if (shape === 'ember') {
        ctx.shadowColor = glow;
        ctx.shadowBlur = 16;
        // outer flame
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.moveTo(0, 8);
        ctx.quadraticCurveTo(-7, 1, -4, -9);
        ctx.quadraticCurveTo(0, -3, 4, -9);
        ctx.quadraticCurveTo(7, 1, 0, 8);
        ctx.fill();
        // hot core
        ctx.fillStyle = '#ffee88';
        ctx.beginPath();
        ctx.moveTo(0, 4);
        ctx.quadraticCurveTo(-3, 0, -1.5, -5);
        ctx.quadraticCurveTo(0, -1, 1.5, -5);
        ctx.quadraticCurveTo(3, 0, 0, 4);
        ctx.fill();
      }
      else if (shape === 'void') {
        ctx.shadowColor = glow;
        ctx.shadowBlur = 18;
        // outer ring
        ctx.strokeStyle = col;
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.arc(0, 0, 7, 0, Math.PI * 2);
        ctx.stroke();
        // spinning inner arcs
        ctx.rotate(t * 6);
        ctx.beginPath();
        ctx.arc(0, 0, 4.5, 0, Math.PI * 1.2);
        ctx.stroke();
        // core
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.arc(0, 0, 2.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.globalAlpha = 0.7;
        ctx.beginPath();
        ctx.arc(0, 0, 1.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      else if (shape === 'shard') {
        ctx.shadowColor = glow;
        ctx.shadowBlur = 12;
        ctx.fillStyle = col;
        // elongated crystal shard
        ctx.beginPath();
        ctx.moveTo(10, 0);
        ctx.lineTo(2, -4);
        ctx.lineTo(-8, -2);
        ctx.lineTo(-8, 2);
        ctx.lineTo(2, 4);
        ctx.closePath();
        ctx.fill();
        // edge highlight
        ctx.strokeStyle = '#fff';
        ctx.globalAlpha = 0.5;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(10, 0);
        ctx.lineTo(2, -4);
        ctx.lineTo(-8, -2);
        ctx.stroke();
        ctx.globalAlpha = 1;
      }
    } else {
      // enemy bullets stay simple
      ctx.shadowColor = col;
      ctx.shadowBlur = 10;
      ctx.fillStyle = col;
      ctx.beginPath();
      ctx.arc(0, 0, b.r, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.restore();
    ctx.shadowBlur = 0;
  });

  enemies.forEach(e => {
    ctx.fillStyle = e.color;
    ctx.shadowColor = e.color;
    ctx.shadowBlur = 12;
    ctx.beginPath();
    ctx.arc(e.x, e.y, e.r, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    if (e.hp < e.maxHp) {
      ctx.strokeStyle = 'rgba(255,255,255,0.25)';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(e.x, e.y, e.r + 5, 0, Math.PI * 2);
      ctx.stroke();
      ctx.strokeStyle = e.color;
      ctx.beginPath();
      ctx.arc(e.x, e.y, e.r + 5, -Math.PI / 2, -Math.PI / 2 + (e.hp / e.maxHp) * Math.PI * 2);
      ctx.stroke();
    }
  });

  if (player.invuln <= 0 || Math.floor(player.invuln / 4) % 2 === 0) {
    ctx.save();
    ctx.translate(player.x, player.y);
    ctx.rotate(player.angle);
    const gunCol = (GUN_SKINS[save.gunSkin] || GUN_SKINS.default).color;
    ctx.shadowColor = gunCol;
    ctx.shadowBlur = 18;
    ctx.fillStyle = gunCol;
    ctx.beginPath();
    ctx.moveTo(16, 0);
    ctx.lineTo(-10, 10);
    ctx.lineTo(-6, 0);
    ctx.lineTo(-10, -10);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#e0ffff';
    ctx.beginPath();
    ctx.arc(-2, 0, 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();
  }

  if (gameState === 'playing') {
    ctx.strokeStyle = 'rgba(0, 255, 200, 0.15)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 6]);
    ctx.beginPath();
    ctx.moveTo(player.x, player.y);
    ctx.lineTo(mouse.x, mouse.y);
    ctx.stroke();
    ctx.setLineDash([]);
    const cId = save.cursorSkin || 'default';
    if (cId !== 'default') {
      drawCursorArt(cId, mouse.x, mouse.y);
    }
  }
  ctx.restore();
}

function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}
loop();
</script>
